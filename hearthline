#!/usr/bin/env bash
# Day-to-day control for a Hearthline lab.
# Author: Edson Lourenço
set -euo pipefail

usage() {
  cat <<EOF
Usage: hearthline <command>

Commands:
  status     Show boot state and probe MiniStack and StackPort
  start      Start the lab
  stop       Stop the lab
  restart    Restart the lab
  logs       Follow the service logs
  endpoint   Print the URLs and the AWS profile
  env        Print the path of the file you can source
EOF
}

load_env() {
  if [[ -f /etc/hearthline/hearthline.env ]]; then
    ENV_FILE=/etc/hearthline/hearthline.env
    USER_MODE=0
  elif [[ -f "${HOME}/.config/hearthline/hearthline.env" ]]; then
    ENV_FILE="${HOME}/.config/hearthline/hearthline.env"
    USER_MODE=1
  else
    printf 'Hearthline is not installed. Run install.sh first.\n' >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$ENV_FILE"
}

ctl() {
  if [[ "$USER_MODE" -eq 1 ]]; then
    systemctl --user "$@"
  elif [[ $EUID -eq 0 ]]; then
    systemctl "$@"
  else
    sudo systemctl "$@"
  fi
}

cmd=${1:-status}
case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
esac
load_env

case "$cmd" in
  status)
    printf 'runtime:   %s\n' "$RUNTIME"
    printf 'boot:      %s\n' "$BOOT_METHOD"
    if [[ "$USER_MODE" -eq 1 ]]; then
      printf 'ministack: %s\n' "$(systemctl --user is-active hearthline-ministack.service 2>/dev/null || true)"
      printf 'stackport: %s\n' "$(systemctl --user is-active hearthline-stackport.service 2>/dev/null || true)"
    else
      printf 'ministack: %s\n' "$(systemctl is-active hearthline-ministack.service 2>/dev/null || true)"
      printf 'stackport: %s\n' "$(systemctl is-active hearthline-stackport.service 2>/dev/null || true)"
    fi
    if curl -fsS --max-time 5 "http://${LAN_IP}:${MINISTACK_PORT}/_ministack/health" >/dev/null; then
      printf 'api:       http://%s:%s  ok\n' "$LAN_IP" "$MINISTACK_PORT"
    else
      printf 'api:       http://%s:%s  down\n' "$LAN_IP" "$MINISTACK_PORT"
    fi
    if [[ "${WITH_STACKPORT:-1}" -eq 1 ]]; then
      if curl -fsS --max-time 5 "http://${LAN_IP}:${STACKPORT_PORT}/api/health" >/dev/null; then
        printf 'console:   http://%s:%s  ok\n' "$LAN_IP" "$STACKPORT_PORT"
      else
        printf 'console:   http://%s:%s  down\n' "$LAN_IP" "$STACKPORT_PORT"
      fi
    fi
    ;;
  start)
    ctl start hearthline-ministack.service
    [[ "${WITH_STACKPORT:-1}" -eq 1 ]] && ctl start hearthline-stackport.service
    ;;
  stop)
    [[ "${WITH_STACKPORT:-1}" -eq 1 ]] && ctl stop hearthline-stackport.service || true
    ctl stop hearthline-ministack.service
    ;;
  restart)
    ctl restart hearthline-ministack.service
    [[ "${WITH_STACKPORT:-1}" -eq 1 ]] && ctl restart hearthline-stackport.service
    ;;
  logs)
    if [[ "$USER_MODE" -eq 1 ]]; then
      journalctl --user -u hearthline-ministack.service -u hearthline-stackport.service -f
    elif [[ $EUID -eq 0 ]]; then
      journalctl -u hearthline-ministack.service -u hearthline-stackport.service -f
    else
      sudo journalctl -u hearthline-ministack.service -u hearthline-stackport.service -f
    fi
    ;;
  endpoint)
    printf 'MiniStack  http://%s:%s\n' "$LAN_IP" "$MINISTACK_PORT"
    [[ "${WITH_STACKPORT:-1}" -eq 1 ]] && printf 'StackPort  http://%s:%s\n' "$LAN_IP" "$STACKPORT_PORT"
    printf 'profile    hearthline\n'
    printf 'region     %s\n' "$REGION"
    ;;
  env)
    printf '%s/env.sh\n' "$CONFIG_DIR"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
